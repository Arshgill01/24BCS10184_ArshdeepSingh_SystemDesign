        </mxCell>
        <mxCell id="bottom-rule" value="" style="shape=line;strokeColor=#DCDCDC;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="797" width="1100" height="1" />
        </mxCell>
        <mxCell id="foot" value="NETFLIX · PROPOSED HLD · EDUCATIONAL DESIGN" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=11;fontColor=#737373;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="813" width="900" height="20" />
