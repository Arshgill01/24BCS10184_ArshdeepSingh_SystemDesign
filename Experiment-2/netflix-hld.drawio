        <mxCell id="account" value="&lt;b&gt;Account &amp; profiles&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#737373&quot; style=&quot;font-size:13px&quot;&gt;Identity · entitlement&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#252525;fillColor=#FAFAFA;strokeColor=#DCDCDC;strokeWidth=1;spacing=10;" vertex="1" parent="1">
