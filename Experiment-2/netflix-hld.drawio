  </diagram>
  <diagram id="page4" name="04 — Flows &amp; operating decisions">
    <mxGraphModel dx="1200" dy="850" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="kicker" value="SYSTEM DESIGN  /  EXPERIMENT 02" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=12;fontColor=#A84141;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="30" width="1000" height="20" />
        </mxCell>
        <mxCell id="title" value="Flows &amp; operating decisions" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=32;fontColor=#252525;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="66" width="1100" height="46" />
        </mxCell>
        <mxCell id="subtitle" value="How a title reaches the viewer, and how the system stays responsive." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#737373;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="122" width="1100" height="40" />
        </mxCell>
        <mxCell id="top-rule" value="" style="shape=line;strokeColor=#DCDCDC;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="175" width="1100" height="1" />
        </mxCell>
        <mxCell id="bottom-rule" value="" style="shape=line;strokeColor=#DCDCDC;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="797" width="1100" height="1" />
        </mxCell>
        <mxCell id="foot" value="NETFLIX · PROPOSED HLD · EDUCATIONAL DESIGN" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=11;fontColor=#737373;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="813" width="900" height="20" />
        </mxCell>
        <mxCell id="number" value="04 / 04" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=11;fontColor=#737373;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1090" y="813" width="70" height="20" />
        </mxCell>
        <mxCell id="playh" value="01 / PLAY A TITLE" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#A84141;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="210" width="530" height="27" />
        </mxCell>
        <mxCell id="playb" value="1. The app signs in and browses through the gateway.&lt;br&gt;2. Playback checks entitlement with Account service&lt;br&gt;    and verifies regional rights from title metadata.&lt;br&gt;3. Return manifest, short-lived CDN authorization,&lt;br&gt;    and a DRM license after successful checks.&lt;br&gt;4. The player requests segments from the CDN,&lt;br&gt;    choosing bitrate based on bandwidth and buffer.&lt;br&gt;5. Every 30 s, report progress via History service;&lt;br&gt;    persist the latest position per profile and title." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#252525;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="250" width="530" height="240" />
        </mxCell>
        <mxCell id="publishh" value="02 / PREPARE &amp; PUBLISH CONTENT" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#A84141;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="210" width="500" height="27" />
        </mxCell>
        <mxCell id="publishb" value="Upload master → durable queue → encoding workers&lt;br&gt;→ package renditions + DRM → video origin → CDN.&lt;br&gt;&lt;br&gt;Workers retry failed jobs safely. Publish the catalog&lt;br&gt;entry and manifest only after all required assets pass&lt;br&gt;validation. Populate the search index asynchronously.&lt;br&gt;&lt;br&gt;Popular titles are pre-positioned at CDN edges.&lt;br&gt;On a cache miss, an edge fetches from the origin." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#252525;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="250" width="500" height="240" />
        </mxCell>
        <mxCell id="flowrule" value="" style="shape=line;strokeColor=#DCDCDC;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="527" width="1100" height="1" />
        </mxCell>
        <mxCell id="reliabilityh" value="03 / RELIABILITY &amp; SCALE" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#A84141;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="555" width="530" height="27" />
        </mxCell>
        <mxCell id="reliabilityb" value="• Stateless APIs scale behind load balancers.&lt;br&gt;• Replicate services and stores across availability zones.&lt;br&gt;• Shard history by profile ID; cache popular metadata.&lt;br&gt;• Retry transient errors with backoff and idempotency.&lt;br&gt;• Route to a healthy region or CDN edge on failure." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#252525;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="595" width="530" height="175" />
        </mxCell>
        <mxCell id="tradeoffsh" value="04 / TRADEOFFS &amp; OBSERVABILITY" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#A84141;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="555" width="500" height="27" />
        </mxCell>
        <mxCell id="tradeoffsb" value="• CDN caching reduces origin traffic and startup time.&lt;br&gt;• Pre-encoding uses storage to save playback compute.&lt;br&gt;• History and discovery may lag; entitlement must not.&lt;br&gt;• If recommendations fail, show a cached popular list.&lt;br&gt;• Track startup delay, rebuffering, API errors, CDN hit&lt;br&gt;  rate, and encoding queue age; alert on regressions." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#252525;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="595" width="500" height="180" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>