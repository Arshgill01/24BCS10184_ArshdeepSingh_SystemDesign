        <mxCell id="subtitle" value="On-demand video streaming across web, mobile, and smart TVs." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#737373;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="122" width="1100" height="40" />
        </mxCell>
        <mxCell id="top-rule" value="" style="shape=line;strokeColor=#DCDCDC;" vertex="1" parent="1">
