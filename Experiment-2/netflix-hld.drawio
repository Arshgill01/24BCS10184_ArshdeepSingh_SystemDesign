        <mxCell id="note2b" value="Red arrows: media delivery. The player fetches video&lt;br&gt;directly from the CDN, bypassing application servers." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#737373;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="741" width="500" height="43" />
        </mxCell>
