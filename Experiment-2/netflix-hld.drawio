        <mxCell id="number" value="01 / 04" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=11;fontColor=#737373;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1090" y="813" width="70" height="20" />
        </mxCell>
        <mxCell id="functionalh" value="FUNCTIONAL REQUIREMENTS" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#A84141;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="211" width="520" height="27" />
        </mxCell>
        <mxCell id="functionalb" value="1. Sign in and manage viewing profiles.&lt;br&gt;&lt;br&gt;2. Browse titles, search, and see recommendations.&lt;br&gt;&lt;br&gt;3. Play, pause, seek, and change video quality.&lt;br&gt;&lt;br&gt;4. Save a watchlist and resume across devices.&lt;br&gt;&lt;br&gt;5. Check subscription and regional viewing rights.&lt;br&gt;&lt;br&gt;6. Ingest, encode, and publish licensed content." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#252525;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="251" width="520" height="365" />
        </mxCell>
        <mxCell id="nonfunctionalh" value="NON-FUNCTIONAL REQUIREMENTS" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#A84141;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="211" width="500" height="27" />
        </mxCell>
        <mxCell id="nonfunctionalb" value="• Availability: target 99.99% for playback APIs.&lt;br&gt;&lt;br&gt;• Speed: API p95 &amp;lt; 300 ms; startup p95 &amp;lt; 2 s&lt;br&gt;  on a healthy broadband connection.&lt;br&gt;&lt;br&gt;• Scale: millions of simultaneous streams.&lt;br&gt;&lt;br&gt;• Reliability: replicated data and regional failover.&lt;br&gt;&lt;br&gt;• Security: TLS, encrypted storage, DRM,&lt;br&gt;  and short-lived playback authorization." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#252525;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="251" width="500" height="365" />
        </mxCell>
        <mxCell id="scope-rule" value="" style="shape=line;strokeColor=#DCDCDC;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="638" width="1100" height="1" />
        </mxCell>
        <mxCell id="scopeh" value="SCOPE &amp; CONSISTENCY" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#A84141;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="665" width="1100" height="27" />
        </mxCell>
        <mxCell id="scopeb" value="Video on demand only. Live streaming, ads, downloads, and payment processing are outside this design.&lt;br&gt;&lt;br&gt;Entitlement checks use authoritative account data. Watch history, search indexes, and recommendations&lt;br&gt;may update asynchronously. All scale figures and performance goals are design assumptions." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=18;fontColor=#252525;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="705" width="1100" height="100" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
