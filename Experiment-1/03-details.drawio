<mxfile host="app.diagrams.net" modified="2026-08-01T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" pages="1"><diagram id="details" name="03 — Details"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#FAFAF8" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q3title" value="Interfaces, data &amp; decisions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#111827;fontSize=34;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="45" width="1100" height="60" as="geometry"/></mxCell><mxCell id="q3sub" value="The details that keep the simple architecture correct." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#64748B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="72" y="108" width="1100" height="40" as="geometry"/></mxCell><mxCell id="q3rule" value="" style="shape=line;strokeColor=#D6D8D5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="70" y="165" width="1660" height="1" as="geometry"/></mxCell><mxCell id="q3h1" value="API" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#6B7C72;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="205" width="400" height="30" as="geometry"/></mxCell><mxCell id="q3api" value="&lt;b&gt;POST /v1/links&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:14px'&gt;{ long_url, custom_alias?, expires_at? }&lt;/span&gt;&lt;br&gt;Headers: Authorization?, Idempotency-Key&lt;br&gt;201 created · 409 alias taken · 422 unsafe · 429 limited&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /{alias}&lt;/b&gt;&lt;br&gt;302 Location · 404 unknown · 410 expired/disabled&lt;br&gt;&lt;br&gt;&lt;b&gt;Manage&lt;/b&gt;&lt;br&gt;GET /v1/links/{alias}&lt;br&gt;PATCH /v1/links/{alias}&lt;br&gt;DELETE /v1/links/{alias}&lt;br&gt;GET /v1/links/{alias}/stats" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#D6D8D5;strokeWidth=1;fontColor=#263238;fontSize=16;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="520" height="445" as="geometry"/></mxCell><mxCell id="q3h2" value="PRIMARY RECORD" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#6B7C72;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="205" width="400" height="30" as="geometry"/></mxCell><mxCell id="q3db" value="&lt;b&gt;links&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:14px'&gt;alias          PK&lt;br&gt;long_url       text&lt;br&gt;owner_id       nullable&lt;br&gt;created_at     timestamp&lt;br&gt;expires_at     nullable&lt;br&gt;status         active | disabled | expired&lt;br&gt;redirect_type  302 | 301&lt;br&gt;version        bigint&lt;/span&gt;&lt;br&gt;&lt;br&gt;Conditional insert guarantees alias uniqueness. Owner/time access can live in a separate index table. Clicks do not belong here." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#D6D8D5;strokeWidth=1;fontColor=#263238;fontSize=16;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="520" height="445" as="geometry"/></mxCell><mxCell id="q3h3" value="OPERATING DECISIONS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#6B7C72;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="205" width="500" height="30" as="geometry"/></mxCell><mxCell id="q3ops" value="&lt;b&gt;Consistency&lt;/b&gt;&lt;br&gt;Strong for create and owner updates; eventual for cache and analytics.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hot links&lt;/b&gt;&lt;br&gt;CDN + Redis; request coalescing on cache miss.&lt;br&gt;&lt;br&gt;&lt;b&gt;Deletion&lt;/b&gt;&lt;br&gt;Disable immediately, push invalidation, purge later. Never reuse aliases.&lt;br&gt;&lt;br&gt;&lt;b&gt;Privacy&lt;/b&gt;&lt;br&gt;Hash/truncate IPs; avoid storing sensitive query strings; time-bound retention.&lt;br&gt;&lt;br&gt;&lt;b&gt;Disaster recovery&lt;/b&gt;&lt;br&gt;RPO ≤ 5 min, RTO ≤ 30 min; cross-region replica and tested DNS failover." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#D6D8D5;strokeWidth=1;fontColor=#263238;fontSize=16;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1210" y="250" width="520" height="445" as="geometry"/></mxCell><mxCell id="q3rule2" value="" style="shape=line;strokeColor=#D6D8D5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="70" y="755" width="1660" height="1" as="geometry"/></mxCell><mxCell id="q3h4" value="ESTIMATED MONTHLY RUN RATE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#6B7C72;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="790" width="500" height="30" as="geometry"/></mxCell><mxCell id="q3cost" value="&lt;b&gt;$18k–$47k / month&lt;/b&gt; at the working scale.&lt;br&gt;&lt;br&gt;Database $8–18k · compute/LB $3–7k · CDN/DNS/WAF $2–8k · Redis $2–5k · analytics $1–4k · observability/backups $2–5k" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#263238;fontSize=17;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="835" width="850" height="125" as="geometry"/></mxCell><mxCell id="q3trade" value="&lt;b&gt;Main tradeoff&lt;/b&gt;&lt;br&gt;&lt;br&gt;Start with managed SQL in one region if product scale is uncertain. Move to partitioned KV/wide-column storage and global reads only when measured load requires it." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#D6D8D5;strokeWidth=1;fontColor=#263238;fontSize=16;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1040" y="815" width="690" height="170" as="geometry"/></mxCell><mxCell id="q3foot" value="Planning estimates, not vendor quotes. Biggest levers: cache hit ratio, cross-region replication, database choice and analytics retention." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#64748B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="1000" width="1660" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
