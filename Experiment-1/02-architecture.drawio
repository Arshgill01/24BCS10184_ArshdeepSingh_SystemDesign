&lt;/b&gt;&lt;br&gt;serve stale briefly; drop/sample analytics before redirect traffic; replicate across 3 AZs." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#D6D8D5;strokeWidth=1;fontColor=#263238;fontSize=16;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1230" y="850" width="500" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
