<mxfile host="app.diagrams.net" modified="2026-08-01T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" pages="1"><diagram id="overview" name="01 — Brief"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#FAFAF8" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q1title" value="URL shortener" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#111827;fontSize=34;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="45" width="1000" height="60" as="geometry"/></mxCell><mxCell id="q1sub" value="A read-heavy system designed for fast, reliable redirects." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#64748B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="72" y="108" width="1100" height="40" as="geometry"/></mxCell><mxCell id="q1rule" value="" style="shape=line;strokeColor=#D6D8D5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="70" y="165" width="1660" height="1" as="geometry"/></mxCell><mxCell id="q1h1" value="WHAT IT MUST DO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#6B7C72;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="205" width="500" height="30" as="geometry"/></mxCell><mxCell id="q1b1" value="&lt;b&gt;Core&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Create a short URL from an http/https destination&lt;br&gt;• Redirect by alias; 302 by default, 301 if immutable&lt;br&gt;• Optional custom alias and expiration&lt;br&gt;• Disable/delete owned links&lt;br&gt;• Show basic click statistics&lt;br&gt;&lt;br&gt;&lt;b&gt;Safety&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Rate limits, abuse reports, phishing/malware checks&lt;br&gt;• Admin takedown and a fast disabled-link blocklist" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#263238;fontSize=17;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="245" width="760" height="400" as="geometry"/></mxCell><mxCell id="q1h2" value="WHAT GOOD LOOKS LIKE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#6B7C72;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="205" width="500" height="30" as="geometry"/></mxCell><mxCell id="q1b2" value="&lt;b&gt;Redirect path&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 99.99% availability&lt;br&gt;• p99 &amp;lt; 50 ms on edge/cache hit&lt;br&gt;• p99 &amp;lt; 150 ms on database lookup&lt;br&gt;&lt;br&gt;&lt;b&gt;Other guarantees&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Unique aliases and read-after-write on create&lt;br&gt;• Analytics may lag by up to 5 minutes&lt;br&gt;• Multi-AZ durability, backups and restore drills&lt;br&gt;• TLS, encryption at rest and privacy-limited logs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#263238;fontSize=17;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="245" width="760" height="400" as="geometry"/></mxCell><mxCell id="q1rule2" value="" style="shape=line;strokeColor=#D6D8D5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="70" y="680" width="1660" height="1" as="geometry"/></mxCell><mxCell id="q1h3" value="WORKING SCALE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#6B7C72;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="715" width="500" height="30" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;100M&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;new links / month&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3EF;strokeColor=none;fontColor=#24352B;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;10B&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;redirects / month&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3EF;strokeColor=none;fontColor=#24352B;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="395" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;40k&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;peak redirect RPS&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3EF;strokeColor=none;fontColor=#24352B;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="720" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;80%&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;target cache hit rate&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3EF;strokeColor=none;fontColor=#24352B;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1045" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b&gt;~12 TB&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;5-year links + replicas/indexes&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF3EF;strokeColor=none;fontColor=#24352B;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1370" y="765" width="360" height="120" as="geometry"/></mxCell><mxCell id="q1note" value="Base62 with 7 characters gives 62⁷ ≈ 3.5T aliases. At this scale, redirect traffic—not link creation—is the main design pressure." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#64748B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="940" width="1660" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
